{
  "name": "stake-wars",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @stakewars/web dev",
    "dev:api": "pnpm --filter @stakewars/api dev",
    "contracts:build": "cd contracts && sozo build",
    "contracts:test": "cd contracts && sozo test",
    "contracts:format": "cd contracts && scarb fmt",
    "contracts:format:check": "cd contracts && scarb fmt --check",
    "build": "pnpm --recursive --filter './apps/*' build",
    "lint": "pnpm --recursive --filter './apps/*' lint",
    "format": "pnpm --recursive --filter './apps/*' format",
    "format:check": "pnpm --recursive --filter './apps/*' format:check",
    "test": "pnpm --recursive --filter './apps/*' --if-present test"
  }
}
